# URL publique de l'API (exposée au navigateur)
VITE_API_URL=http://localhost:8000
# URL de l'API utilisée côté serveur (SSR, OAuth). Par défaut : VITE_API_URL
API_CLIENT_URL=

# OAuth (secrets serveur uniquement, ne jamais préfixer par VITE_)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_DRIBBBLE_ID=
AUTH_DRIBBBLE_SECRET=
